NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/global_scholars_hub
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
